<Window x:Class="BookStoreManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        Title="Dream Book Store" 
        Height="600" 
        Width="950" 
        ResizeMode="CanMinimize"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/UIResource.xaml"/>
                <ResourceDictionary Source="Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <!-- Placeholder for background gradient -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Cornsilk"  Offset="0.0"/>
                <GradientStop Color="Aqua"  Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Button  Name ="InforButton"
                 Width="30" 
                 Height="30"
                 Margin="0, 10, 20, 0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Click="InforButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill >
                                            <ImageBrush
                                                    ImageSource="Images/Main/Female.png"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
           
        </Button>
   
        <Label Content="DREAM BOOK STORE"
                FontWeight="Bold"
                FontSize="24"
                HorizontalAlignment="Center"/>
        <!-- Nút MENU Thu Gọn/Mở Rộng -->
        <Button x:Name="MenuButton" 
                Width="30" 
                Height="30"
                BorderBrush="Transparent"
                Background="Transparent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 10, 0, 0"
                Click="MenuButton_Click">
            <Image Source="Images/Main/menu.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <!-- Thanh Điều Hướng -->
        <StackPanel x:Name="NavigationPanel"
                    Margin="10, 0, 800, 0"
                    Width="120">

            <Button Name="DashboardButton" 
                    Content="TRANG CHỦ" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Margin="0, 100, 0, 10"
                    Style="{StaticResource RoundedButton}"
                    Click="DashboardButton_Click"/>
            
            <Button Name="OrderButton" 
                    Content="ĐƠN HÀNG" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Margin="0, 0, 0, 10"
                    Style="{StaticResource RoundedButton}"
                    Click="OrderButton_Click"/>
                
            <Button Name="ProductButton" 
                    Content="SẢN PHẨM" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Margin="0, 0, 0, 10"
                    Style="{StaticResource RoundedButton}"
                    Click="ProductButton_Click"/>
                
            <Button Name="CustomerButton" 
                    Content="KHÁCH HÀNG" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Margin="0, 0, 0, 10"
                    Style="{StaticResource RoundedButton}"
                    Click="CustomerButton_Click"/>
                
            <Button Name="Button" Content="THỐNG KÊ" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Margin="0, 0, 0, 10"
                    Style="{StaticResource RoundedButton}"
                    Click="StatisticButton_Click"/>
        </StackPanel>

        
        
        <!-- Khu Vực Nội Dung Chính -->

        <Frame Name="MainContent" 
               Margin="140,50,20,20"
               NavigationUIVisibility="Hidden"
               Background="LightCyan" Height="515">
            
        </Frame>

        <Border Name="InforBorder"
                CornerRadius="10" 
                Background="{StaticResource ColorBackground1}" 
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Width="200"
                Height ="200"
                Margin="0,42,20,0" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="5"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
              
                <Button Content="Xem thông tin"
                    FontWeight="Medium"
                    Background="Aqua"
                    BorderBrush="Transparent"
                    Style="{StaticResource RoundedButton}"
                    Margin="0, 20, 0 ,0"
                    Height="40"
                    Width ="180">
                </Button>
                <Button x:Name="LogoutButton"
                    Content="ĐĂNG XUẤT"
                    FontWeight="Medium"
                    FontSize="10"
                    Margin="0, 90, 0, 0"
                    Background="Transparent"
                    BorderBrush="Transparent"                
                    Height="40"
                    Width="180"
                    Style="{StaticResource CustomButtonTemplate}" 
                    Click="LogoutButton_Click"/>

            </StackPanel>
        </Border>
      

    </Grid>
</Window>