<Window x:Class="BookStoreManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        Title="Dream Book Store" 
        Height="600" 
        Width="950" 
        ResizeMode="CanMinimize"       
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resource/UIResource.xaml"/>
                <ResourceDictionary Source="../../Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource LightColorBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button  Name ="InforButton"
                 Grid.Column="1"
                 Grid.Row="0"
                 Width="30" 
                 Height="30"
                 Margin="0, 10, 20, 0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Click="InforButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill >
                                            <ImageBrush
                                                    ImageSource="../../Images/Main/Female.png"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>

        </Button>

        <Label Content="DREAM BOOK STORE"              
                Grid.ColumnSpan="2"
                FontWeight="Bold"
                FontSize="24"
                HorizontalAlignment="Center"/>
        <!-- Nút MENU Thu Gọn/Mở Rộng -->
        <Button x:Name="MenuButton" 
                Width="30" 
                Height="30"
                BorderBrush="Transparent"
                Background="Transparent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 10, 0, 0"
                Click="MenuButton_Click">
            <Image Source="../../Images/Main/menu.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <!-- Thanh Điều Hướng -->
        <StackPanel x:Name="NavigationPanel"
                    Grid.Row="1"
                    Visibility="Visible"
                    Margin="0,80,0,0"
                    Width="140"
                    HorizontalAlignment="Left">

            <Button Name="DashboardButton"                    
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="5, 0, 0, 5"
                    Style="{StaticResource RoundedButton}"
                    Click="DashboardButton_Click">
                <Button.Content>
                    <TextBlock Text="⏱ TRANG CHỦ" TextAlignment="Left" Width="115" Margin="15,0,0,0"/>
                </Button.Content>
            </Button>

            <Button Name="OrderButton" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="5, 0, 0, 5"
                    Style="{StaticResource RoundedButton}"
                    Click="OrderButton_Click">
                <Button.Content>
                    <TextBlock Text="📦 ĐƠN HÀNG" TextAlignment="Left" Width="115" Margin="15,0,0,0"/>
                </Button.Content>
            </Button>

            <Button Name="ProductButton" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="5, 0, 0, 5"
                    Style="{StaticResource RoundedButton}"
                    Click="ProductButton_Click">
                <Button.Content>
                    <TextBlock Text="📖 SẢN PHẨM" TextAlignment="Left" Width="115" Margin="15,0,0,0"/>
                </Button.Content>
            </Button>

            <Button Name="CustomerButton" 
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="5, 0, 0, 5"
                    Style="{StaticResource RoundedButton}"
                    Click="CustomerButton_Click">
                <Button.Content>
                    <TextBlock Text="🙍🏼‍ KHÁCH HÀNG" TextAlignment="Left" Width="115" Margin="15,0,0,0"/>
                </Button.Content>
            </Button>

            <Button Name="Button" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="Green"
                    FontWeight="Bold"
                    Height="50"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="5, 0, 0, 5"
                    Style="{StaticResource RoundedButton}"
                    Click="StatisticButton_Click">
                <Button.Content>
                    <TextBlock Text="📈 THỐNG KÊ" TextAlignment="Left" Width="115" Margin="15,0,0,0"/>
                </Button.Content>
            </Button>
        </StackPanel>

        <!-- Khu Vực Nội Dung Chính -->

        <Frame Name="MainContent" 
               Margin="140,50,20,20"
               Grid.ColumnSpan="2"
               Grid.RowSpan="2"
               NavigationUIVisibility="Hidden" Height="515" Background="LightCyan"/>

        <Border Name="InforBorder"
                Grid.Column="1"
                Grid.RowSpan="2"
                CornerRadius="10" 
                Background="{StaticResource ColorBackground1}" 
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Width="200"
                Height ="200"
                Margin="0,42,20,0" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="5"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Button Name="InforUserButton"
                    
                    FontWeight="Medium"
                    Background="Aqua"
                    BorderBrush="Transparent"
                    Style="{StaticResource RoundedButtonStyle}"
                    Margin="0, 20, 0 ,0"
                    Height="40"
                    Width ="170" 
                    Click="InforUserButton_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    Width="150"
                                    Margin="0,3,0,0">
                            <TextBlock Text="🙍🏼‍" 
                                       HorizontalAlignment="Left"
                                       FontSize="14"
                                       Margin="0,0,0,0"/>
                            <TextBlock Text="Xem thông tin"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       Margin ="20,0,0,0"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button 
                    FontWeight="Medium"
                    Background="Aqua"
                    BorderBrush="Transparent"
                    Style="{StaticResource RoundedButtonStyle}"
                    Margin="0, 10, 0 ,0"
                    Height="40"
                    Width ="170"
                    Click ="Setting_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    Width="150"
                                    Margin="0,3,0,0">
                            <TextBlock Text="⚙"
                                       HorizontalAlignment="Left"
                                       FontSize="14"
                                       Margin="0,0,0,0"/>
                            <TextBlock Text="Cài đặt"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       Margin ="35,0,0,0"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="LogoutButton"
                    Content="ĐĂNG XUẤT"
                    FontWeight="Medium"
                    FontSize="10"
                    Margin="0, 40, 0, 0"
                    Background="Transparent"
                    BorderBrush="Transparent"                
                    Height="40"
                    Width="170"
                    Style="{StaticResource CustomButtonTemplate}" 
                    Click="LogoutButton_Click"/>

            </StackPanel>
        </Border>


    </Grid>
</Window>