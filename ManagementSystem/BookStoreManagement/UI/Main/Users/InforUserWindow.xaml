<Window x:Class="BookStoreManagement.InforUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement.Converter"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Title="Thông tin nhân viên" Height="400" Width="650" Loaded="InforUser_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="0, 50, 0, 0"
                    Grid.Row="1"
                    HorizontalAlignment="Center" 
                     VerticalAlignment="Top"
                    Width="460" Height="300">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="71" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <!-- Mã nhân viên -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Mã nhân viên:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBox  Name="txtUserID"
                              Text="{Binding UserId}"
                              Width="200" Height="27"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              IsEnabled="False"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              Style="{StaticResource FlatTextBox}"/>
                </StackPanel>


                <!-- Tên khách hàng -->
                <StackPanel Margin="10, 0, 0, 0" Grid.Row="0" Grid.Column="1"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Tên nhân viên:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorName"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtName"
                             Text="{Binding Fullname}"
                                 Width="224" Height="27"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Margin="4 0 0 0"
                                 HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}"/>
                </StackPanel>


               
                <!-- Giới tính -->
                <StackPanel Margin="0, 15, 0, 0" 
                            Grid.Row="1" Grid.Column="0"
                             >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Giới tính:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorSex"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                     Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <ComboBox Name="txtSex"
                              Text="{Binding Sex}"
                              Height="27"
                              Width="100" 
                              FontSize="12"
                              FontWeight="Medium"
                              HorizontalAlignment="Left"
                              Margin="4,0,0,0"
                              Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem>Nam</ComboBoxItem>
                        <ComboBoxItem>Nữ</ComboBoxItem>

                    </ComboBox>

                </StackPanel>

                <!-- Số điện thoại -->
                <StackPanel Grid.Row="1" Grid.Column="1"

                            Margin="10, 15, 0, 0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Số điện thoại:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorPhone"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                    Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtPhone"
                             Text="{Binding Phone}"
                             Width="224" Height="27"
                             FontSize="12"
                             FontWeight="Medium"
                              Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Background="Transparent"
                             Style="{StaticResource FlatTextBox}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0, 15 , 0, 0" Grid.Row="2" Grid.Column="0"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Email:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorEmail"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                     Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox  Name="txtEmail"
                              Text="{Binding Email}"
                              Width="200" Height="27"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              Style="{StaticResource FlatTextBox}"/>
                </StackPanel>
            </Grid>
            <Button Name="updateButton" Content="Cập nhật"
                    Height="35"
                   
                    FontWeight="Bold"
                    Style="{StaticResource FlatButton}"
                    Margin="0, 25, 0 ,0" Click="updateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
