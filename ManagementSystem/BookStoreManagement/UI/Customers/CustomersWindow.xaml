<UserControl x:Class="BookStoreManagement.Customers.CustomersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             d:DesignHeight="530" d:DesignWidth="790" Loaded="Customer_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="450"/>
        </Grid.RowDefinitions>

        <Button 
            x:Name="AddCustomer"
            Grid.Row="0"
            Content="➕Thêm"
            Height="27"
            Width="55"
            Foreground="White"
            Margin="30,0,0,0"
            FontSize="10"
            Background="Brown"
            FontWeight="Bold"
            HorizontalAlignment="Left"
            BorderBrush="Transparent" 
            Style="{StaticResource RoundedButtonStyle}"
            Click="AddCustomer_Click"/>
        <Border 
            Name="Border"
            Background="White"
            CornerRadius="5"
            BorderThickness="2"
            VerticalAlignment="Top"
            Grid.Row="1"
            Width="660"
            Height="50">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="0"
                    BlurRadius="5"
                    Opacity="0.5">
                </DropShadowEffect>
            </Border.Effect>
            <StackPanel 
                    Orientation="Horizontal">
                <!--Cột Mã khách hàng-->
                <TextBlock 
                    Text="Mã KH"
                    Height="30"
                    FontSize="11"
                    TextAlignment="Center"
                    FontWeight="Medium"
                    Padding="0,10,0,0"
                    Width="75"
                    Margin="0,0,0,0"
                    Background="Transparent">
                </TextBlock>
                <!--Cột tên khách hàng-->
                <TextBlock 
                       Text="Tên KH"
                       TextAlignment="Center"
                       FontSize="11"
                       FontWeight="Medium"
                       Height="30"
                       Width="80"
                       Padding="0,10,0,0"
                       Margin="10,0,5,0"
                       Background="Transparent"/>

                <!--Cột giới tính-->
                <StackPanel Orientation="Horizontal"
                        Width="60"
                        Height="30"
                        Margin="20,0,5,0"
                        >
                    <TextBlock Text="Giới tính"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="60"
                           Background="Transparent"/>

                </StackPanel>

                <!--Cột địa chỉ-->
                <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="25,0,5,0"
                        >
                    <TextBlock Text="Địa chỉ"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="70"
                           Background="Transparent"/>

                </StackPanel>

                <!--Cột Email-->
                <StackPanel Orientation="Horizontal"
                        Width="90"
                        Height="30"
                        Margin="10,0,5,0"
                        >
                    <TextBlock Text="Email"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

                </StackPanel>

                <!--Cột SDT-->
                <StackPanel Orientation="Horizontal"
                        Width="90"
                        Height="30"
                        Margin="40,0,0,0"
                        >
                    <TextBlock Text="SĐT"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

                </StackPanel>
            </StackPanel>
        </Border>
        <ListView Name="CustomerList" 
                  Margin="40,50,40,80"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1,2,1,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="3, 1, 3, 1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border 
                          CornerRadius="5"  
                          BorderThickness="0.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0, 7, 0, 7"
                          Height ="45"
                          Width="650"
                          Background="LightGreen"
                          BorderBrush="Transparent">
                        <Border.Effect>
                            <DropShadowEffect
                    Color="Gray"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="5"
                    Opacity="0.5" />
                        </Border.Effect>
                        <Button Name="detailCustomerButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0, 7, 0, 7"
                            Height ="45"
                            Width="650"
                            Background="LightGreen"
                            BorderBrush="Transparent"                           
                            Click="detailCustomerButton_Click"
                            Style="{StaticResource RoundedButtonStyle}">
                            <StackPanel Margin="0, 0, 0, 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="650">
                                <!--Mã khách hàng-->
                                <TextBlock x:Name="txtCustomerID" 
                                       Width="40"
                                       TextAlignment="Center"
                                       Text="{Binding CustomerID}" 
                                       FontSize="11"  
                                       Margin="10, 0, 0, 0"
                                       FontWeight="Medium"/>

                                <!--Tên khách hàng-->
                                <TextBlock Text="{Binding Name}"
                                       FontSize="11"
                                       Width="150"
                                       Margin="0, 0, 0, 0"
                                       TextAlignment="Center"
                                       FontWeight="Medium"/>

                                <!--Giới tính-->
                                <TextBlock Text="{Binding Sex}"
                                       FontSize="11"
                                       Width="30"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                                <!--Địa chỉ-->
                                <TextBlock Text="{Binding Address}"
                                       FontSize="11"
                                       Width="170"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                                <!--Email-->
                                <TextBlock Text="{Binding Email}"
                                       FontSize="11"
                                       Width="140"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"
                                       />

                                <!--SDT-->
                                <TextBlock Text="{Binding Phone}"
                                       FontSize="11"
                                       Width="120"
                                       TextAlignment="Center"
                                       Margin="0, 0, 10, 0"
                                       FontWeight="Medium"
                                       />
                            </StackPanel>
                        </Button>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="40">
            <Button Content="◀" 
                    Click="Previous_Click" 
                    FontSize="14"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    Margin="0, 0, 0, 0"
                    Width="25" 
                    Height="25"/>

            <TextBlock x:Name="PageInfo" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           
                           TextAlignment="Center"
                           Padding="2, 8, 0, 0"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="30"
                           Height="30"/>

            <Button Content="▶" 
                    Click="Next_Click"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    FontSize="14"
                    Width="25"
                    Height="25"/>

        </StackPanel>
    </Grid>
</UserControl>
