<Window x:Class="BookStoreManagement.UI.Config.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement.UI.Config"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize"
        Background="White"
        Loaded="Config_Loaded"
        Title="Cấu hình" Height="360" Width="420">
    <Grid Name="MainContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--Hiển thị title-->
        <TextBlock
            Text="Cấu hình DataBase"
            Margin="10"
            Foreground="#0B666A"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            FontFamily="Segoe UI"
        ></TextBlock>

        <Border Grid.Row="1" 
                BorderThickness="1"
                BorderBrush="#186F6D" 
                CornerRadius="5" 
                Background="White" 
                Height="32" 
                Width="275" Margin="5" 
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <Grid Width="265" Margin="0" HorizontalAlignment="Center">
                <TextBox x:Name="txtServername"
                         BorderThickness="0" 
                         VerticalContentAlignment="Center"  
                         FontSize="13" Width="265"
                    ></TextBox>
                <TextBlock IsHitTestVisible="False" 
                           Text="Nhập server" 
                           VerticalAlignment="Center"
                           FontSize="13"
                           HorizontalAlignment="Left" 
                           Margin="5,0,0,0"
                           Foreground="DarkGray">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtServername}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

       

        <Border Grid.Row="2" 
                BorderThickness="1" 
                BorderBrush="#186F6D" 
                CornerRadius="5" 
                Background="White" 
                Height="32" 
                Width="275" 
                Margin="5" 
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <Grid Width="265" Margin="0" HorizontalAlignment="Center">
                <TextBox BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                        Width="265" x:Name="txtDatabase">
                </TextBox>
                <TextBlock IsHitTestVisible="False" Text="Nhập tên database" 
                           VerticalAlignment="Center"
                           FontSize="13"
                           HorizontalAlignment="Left" Margin="5,0,0,0"
                           Foreground="DarkGray">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtDatabase}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- NÚT KẾT NỐI -->
        <Button
            Grid.Row="4" 
            VerticalAlignment="Top" 
            HorizontalAlignment="Center"
            Name="Button"
            Width="110"
            Height="35"    
            Background="#B7BCCC"
            BorderThickness="0.5"
            Click="ConnectButton_Click"
            >
            <StackPanel
            Orientation="Horizontal">
              
                <TextBlock
                    FontWeight="Bold"
                    Foreground="#0B666A"
                    VerticalAlignment="Center"
                >Kết nối</TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</Window>
