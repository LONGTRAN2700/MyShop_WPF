<UserControl x:Class="BookStoreManagement.Products.ProductsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="Product_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="AliceBlue"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="470"></RowDefinition>
        </Grid.RowDefinitions>

        <ListView Name="BookList" 
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Width="690"
                  Height="400"
                  Background="AliceBlue"
                  BorderBrush="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  Margin="10,0,0,40">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="Background" Value="AntiqueWhite"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Name="DetaiBookButton"
                            HorizontalAlignment="Center"
                            Margin="0, 2, 0, 2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="130"
                            Height="180"
                            Click="detaiProductButton_Click"
                            Style="{StaticResource CustomButtonTemplate}">
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0, 5, 2, 0"
                                Width="130"
                                Height="180">
                        <Border Name="itemsBorder"
                                CornerRadius="5" 
                                Background="AliceBlue" 
                                BorderBrush="Black"
                                BorderThickness="2"
                                Width="90"
                                Height ="120"
                                >
                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="320"
                                                  ShadowDepth="5"
                                                  BlurRadius="10"
                                                  Opacity="0.5" />
                            </Border.Effect>
                            <Image Width="90" 
                                   Height="90"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0, 0, 0, 0"
                                   Source="{Binding ImageURL, 
                                                    Converter={StaticResource AbsoluteConverter}}"/>
                        </Border>

                            <StackPanel Width="100"
                                    Height="30"
                                    Margin="0, 10, 0, 0">
                                <TextBlock x:Name="tblBookName" 
                                       TextAlignment="Center"
                                       VerticalAlignment="Top"
                                       Text="{Binding BookName}" 
                                       FontSize="11"  
                                       Width="100"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                 >

                                </TextBlock>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Text="{Binding Price, Converter={StaticResource MoneyConverter}}"
                                       FontSize="11"
                                       Foreground="Red"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>
                        </StackPanel>              
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <StackPanel  Orientation="Horizontal" 
                     Margin="15, 0, 0 , 0">
            <TextBox x:Name="SearchTextBox" 
                     Width="200"
                     FontSize="14"
                     FontWeight="Medium"                  
                     Padding="0, 0, 0, 5"
                     Style="{StaticResource FlatTextBox}"
                     KeyUp="SearchTextBox_KeyUp" />

            <Popup x:Name="SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=SearchTextBox}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding Path=IsKeyboardFocusWithin, 
                        RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TextBox}}, 
                        Mode=OneWay}">

                <ListBox x:Name="SuggestionsListBox"
                     Width="{Binding ActualWidth, ElementName=SearchTextBox}"
                     Height="200"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     IsSynchronizedWithCurrentItem="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Name="detailProductButton" 
                                Click="detaiProductButton_Click"
                                Width="200"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Style="{StaticResource CustomButtonTemplate}" >
                                <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Left"
                                        Width="200">
                                    <Image Source="{Binding ImageURL, Converter={StaticResource AbsoluteConverter}}" 
                                       Width="50" 
                                       Height="50"
                                       HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BookName}"
                                           FontSize="10"
                                           Margin="5,0,0,0"
                                           Width="120"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap">
                                        </TextBlock>
                                        <TextBlock Text="{Binding Price, Converter={StaticResource MoneyConverter}}" 
                                               Margin="5,0,0,0"
                                               FontSize="10"
                                               Foreground="Red"
                                               FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>
            <Image Source="../../Images/Products/Search.png" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="30"
                   Height="300"/>
        </StackPanel>
  
        <Grid  Grid.Column="1"
               Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Name="addBorder"
                    CornerRadius="5" 
                    BorderBrush="Black"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left" 
                    Grid.Column="0" 
                    Margin="0,5,0,0">
                <Border.Effect>
                    <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    BlurRadius="20"
                    Opacity="0" />
                </Border.Effect>
                <StackPanel 
                    Orientation="Horizontal" Width="230"
                    Height="35">
                    <ComboBox Name="SortProduct"
                      FontSize="11"
                      Width="97"
                      HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                      FontWeight="Medium"
                       Margin="7, 0, 0, 7"
                      Padding="0, 0, 0, 5"                      
                      Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem Content="Mặc định"/>
                        <ComboBoxItem Content="Giá tăng dần"/>
                        <ComboBoxItem Content="Giá giảm dần"/>
                    </ComboBox>

                    <ComboBox Name="PriceSearch"
                      FontSize="11"
                      Width="80"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      FontWeight="Medium"
                      Margin="8, 0, 0, 7"
                      Padding="0, 0, 0, 5"                      
                      Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem Content="Mặc định"/>
                        <ComboBoxItem Content="0-50k"/>
                        <ComboBoxItem Content="50k-100k"/>
                        <ComboBoxItem Content="100k-200k"/>
                        <ComboBoxItem Content="200k-300k"/>
                        <ComboBoxItem Content=">300k"/>
                    </ComboBox>

                    <Button Name="SortButton"
                        Background="LightCyan"
                        BorderBrush="Green"
                        BorderThickness="3"
                        FontSize="16"
                        Width="25"
                        Height="25"
                        Margin ="7, 2, 0, 2"
                        Style="{StaticResource CustomButtonTemplate}"
                        Click="SortButton_Click">
                        <Image Source="../../Images/Products/Sort.png"
                           Height="16"
                           Width="16"                          
                           RenderOptions.BitmapScalingMode="HighQuality"
                           />
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Right"
                        Margin="0, 0, 25, 0"
                        Orientation="Horizontal"
                        Grid.Column="1">
                <Button x:Name="AddProduct"
                    Content="➕Thêm" 
                    Width="55"
                    Height="27"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Background="LightGreen"
                    FontSize="11"
                    FontWeight="Medium"
                    Margin="0, 0, 5, 0"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Click="AddProduct_Click"/>
                <Button x:Name="ImportProduct"
                    Content="🔳 Nhập" 
                    Width="55"
                    Height="27"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Background="LightGreen"
                    FontSize="11"
                    FontWeight="Medium"
                    Margin="0, 0, 5, 0"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Click="ImportProduct_Click"/>
                <Button x:Name="ExportProduct"
                    Content="🔘 Xuất" 
                    Width="55"
                    Height="27"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Background="LightGreen"
                    FontSize="11"
                    FontWeight="Medium"
                    Margin="0, 0, 15, 0"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Click="ExportProduct_Click"/>
                <Button Content="◀" 
                    Click="Previous_Click" 
                    FontSize="14"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    Margin="0, 0, 0, 0"
                    Width="25" 
                    Height="25"/>
                
                <TextBlock x:Name="PageInfo" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           
                           TextAlignment="Center"
                           Padding="2, 8, 0, 0"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="30"
                           Height="30"/>

                <Button Content="▶" 
                    Click="Next_Click"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    FontSize="14"
                    Width="25"
                    Height="25"/>
             
            </StackPanel>
            
        </Grid>
        
    </Grid>
</UserControl>
