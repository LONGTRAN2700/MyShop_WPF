<UserControl x:Class="BookStoreManagement.Products.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        mc:Ignorable="d"
        Height="530" Width="790">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition Width="500"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                Grid.Column="0"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 15 ,0, 0 "
                Width="30"
                Height="30"
                Background="Transparent"
                BorderBrush="Green"
                BorderThickness="2,2,2,2"
                FontSize="40"
                FontWeight="Bold"
                Style="{StaticResource CustomButtonTemplate}"
                Click="BackButton_Click">
            <Image Source="../../Images/Products/back.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <Label Content="THÊM SẢN PHẨM MỚI"
               FontSize="18"
               FontWeight="Medium"
               Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
               Margin="0, 15, 0, 0"/>
        <Border Name="addBorder"
                CornerRadius="10" 
                 BorderBrush="Brown"
                BorderThickness="2"
                VerticalAlignment="Top"
                Margin="0, 90, 0, 0"
                HorizontalAlignment="Center" 
                Width="600" Height="380" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    BlurRadius="20"
                    Opacity="0" />
            </Border.Effect>
            <StackPanel Width="550" Height="350" Margin="0, 25,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="71" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <!-- Tên sách -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
                                Margin="10, 0, 0, 0">
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="📕 Tên sách:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorName"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>

                        <TextBox  Name="txtName"
                              Width="220" Height="30"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource FlatTextBox}" 
                              Background="Transparent"/>
                    </StackPanel>


                    <!-- Tác giả -->
                    <StackPanel Margin="40,0,0,0" Grid.Row="0" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="👨🏼‍💼 Tác giả:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorAuthor"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>
                        <TextBox Name="txtAuthor"
                                 Width="220" Height="30"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Margin="4, 0 0 0"
                                 HorizontalAlignment="Left"
                                  Style="{StaticResource FlatTextBox}"/>
                    </StackPanel>


                    <!-- Họ tên -->
                    <StackPanel Grid.Row="1" Grid.Column="0"                          
                            Margin="10, 15, 0, 0" >
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="💰 Giá cả:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorPrice"
                                   Text="*Giá cả không hợp lệ"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>
                        <TextBox Name="txtPrice"
                             Width="220" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                             Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                    </StackPanel>

                    <!-- Thể loại -->
                    <StackPanel Margin="40, 15, 0, 0" 
                            Grid.Row="1" Grid.Column="2"
                             >
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="🏷 Thể loại:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorCategory"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <ComboBox Name="txtCategory"
                                      SelectionChanged="ComboBox_SelectionChanged"
                                      Height="30"
                                      Width="100" 
                                      FontSize="12"
                                      FontWeight="Medium"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ComboBoxFlatStyle}">
                                <ComboBoxItem>Văn học</ComboBoxItem>
                                <ComboBoxItem>Khoa học</ComboBoxItem>
                                <ComboBoxItem>Khác</ComboBoxItem>
                            </ComboBox>
                            <TextBox x:Name="myTextBox" 
                                     Visibility="Collapsed"
                                     Width="180" Height="30"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     Margin="4, 0 0 0"
                                     HorizontalAlignment="Left"
                                     LostFocus="TextBox_LostFocus"
                                     Style="{StaticResource FlatTextBox}"/>
                        </StackPanel>


                    </StackPanel>

                    <!-- Quantity -->
                    <StackPanel Grid.Row="2" Grid.Column="0"
                            Margin="10, 15, 0, 0">
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="🧮 Số lượng:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorQuantity"
                                   Text="*Số lượng không hợp lệ"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>

                        <TextBox Name="txtQuantity"
                             Width="100" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                              Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                    </StackPanel>

                    <!-- Mô tả -->
                    <StackPanel Margin="40,15,10,0" Grid.Row="2" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="📃 Mô tả:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                            <TextBlock Name="txtErrorDescription"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                        </StackPanel>
                        <TextBox  Name="txtDescription"
                              Width="220" Height="82"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              TextWrapping="Wrap"
                              HorizontalAlignment="Left"                           
                              Background="Transparent"/>
                    </StackPanel>
                </Grid>
                <Button Name="addButton" Content="Thêm sản phẩm"
                    Height="35"
                    Width="400"
                    Foreground="White"
                    VerticalAlignment="Bottom"
                    FontWeight="Bold"
                    Style="{StaticResource FlatButton}"
                    Margin="0, 25, 0 ,0" Click="addButton_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
