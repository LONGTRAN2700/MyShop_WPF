<Window x:Class="BookStoreManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement" 

        mc:Ignorable="d"
        Title="LoginWindow" Height="528" Width="850" ResizeMode="CanMinimize">
    
    <Window.Resources>

        <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger 
                    Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Blue"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#FFD3D3D3"/>
            <Setter Property="Background" Value="#FFF"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#FFD3D3D3"/>
            <Setter Property="Background" Value="#FFF"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <!-- Placeholder for background gradient -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Cornsilk"  Offset="0.0"/>
                <GradientStop Color="Aqua"  Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Placeholder for the image or color where the clock is -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,30,0,0">
            <Border.Background>
                <SolidColorBrush Color="#FFD8A658" />
            </Border.Background>
            
        </Border>

        <!-- Login form container -->
        <StackPanel HorizontalAlignment="Right" 
                    VerticalAlignment="Stretch" 
                    Width ="400"
                    Background="AliceBlue">
           
            <TextBlock Text="ĐĂNG NHẬP"
                       Margin="0,30,0,50"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontWeight="Bold"
                       FontSize="24" />
            <!-- Username input -->
            <StackPanel Margin="50,30,0,15">
                <StackPanel Orientation="Horizontal">
                    <Label Content="TÀI KHOẢN:" 
                       Width="80"                       
                       FontWeight="Bold" />
                    <TextBox Name="txtUsername" 
                         Style="{StaticResource FlatTextBox}" 
                         Background="Transparent" 
                         Width="200"
                         Foreground="Brown"
                         FontSize="15"
                         FontFamily="Bahnschrift SemiBold"
                        />
                </StackPanel>

                <TextBlock Name="txtErrorUsername"
                           Text="*Tài khoản không được để trống" 
                           Foreground="Red"
                           FontSize="8"
                           TextAlignment="Left"
                           HorizontalAlignment="Left"
                           Margin="80, 0, 0, 0"
                           Visibility="Hidden"
                           Width="150"/>

            </StackPanel>

            <!-- Password input -->
            <StackPanel  Margin="50,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Label Content="MẬT KHẨU:" 
                       Width="80" 
                       FontWeight="Bold"/>
                    <PasswordBox Name="txtPassword" 
                             Style="{StaticResource FlatPasswordBox}" 
                             Background="Transparent"
                             Width="200"/>
                </StackPanel>
                <TextBlock Name="txtErrorPassword"
                           Text="*Mật khẩu không được để trống" 
                           Foreground="Red"
                           FontSize="8"
                           HorizontalAlignment="Left"
                           Margin="80, 0, 0, 0"
                           Visibility="Hidden"
                           Width="150"/>
            </StackPanel>

            <!-- Login button -->
            <Button Name="LoginButton" 
                    Content="Đăng nhập"
                    HorizontalAlignment="Center" 
                    Margin="0,40,0,10" 
                    Width="280" 
                    Height="35"
                    Foreground="White"
                    FontSize="16" FontWeight="Bold" Click="LoginButton_Click"
                    >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="DarkCyan"/>
                        <Setter Property="Foreground" Value="Cyan"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Brown"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>


            <!-- Optional: Footer for additional controls or information -->
            <TextBlock HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Margin="0,60,0,10">       
                    CHƯA CÓ TÀI KHOẢN? 
                     <Button Style="{StaticResource LinkButton}" 
                                    Command="{Binding RegisterCommand}" Click="registerButton_Click">
                        <TextBlock TextDecorations="Underline" 
                                    FontWeight="Bold"
                                    Margin="0,0,0,-3">ĐĂNG KÝ</TextBlock>
                     </Button>
            </TextBlock>
        </StackPanel>

        <StackPanel Width ="450"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Stretch">
            <TextBlock Text="CHÀO MỪNG BẠN ĐÃ ĐẾN VỚI DREAM"
                       FontSize="22"
                        FontFamily="Bahnschrift SemiBold"
                       FontWeight="Bold"
                       Foreground="Red"
                       Margin="0, 30, 0,0"
                       HorizontalAlignment="Center" 
                       />
            <Image Name="logoLogin"
                   Source="../../Images/Login/logoMyshop02.png"
                   Width="250" 
                   Height="250" 
                   Margin="0, 50, 0, 0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

        </StackPanel>
      
    </Grid>
</Window>
