<UserControl x:Class="BookStoreManagement.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="DashBoard_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resource/UIResource.xaml"/>
                <ResourceDictionary Source="../../Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Số lượng sản phẩm đang bán-->
        <Border Name="Products"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="0" Grid.Row="0"
                Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="10,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel >
                <Label Content="PRODUCTS"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                      
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblProduct"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(sản phẩm đang bán)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

            </StackPanel>
        </Border>


        <Border Name="Produ"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="1" Grid.Row="0"
                Height="100" 
                Width="160"
               Background="White"
               VerticalAlignment="Top"
                Margin="5,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel Name="OrderStackPanel">
                <Label Content="ORDERS"
                        FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

                <TextBlock Name="tblOrderQuantity"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(đơn hàng trong tuần)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!--Sắp hết hàng-->
        <Border Name="Product"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="2" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="0,20,10,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="RUNNING OUT OF STOCK"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblStock"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(số lượng ‹ 5)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Name="Producs"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="3" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="0,20,25,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="CUSTOMER"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblCustomer"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="medium"
                           FontSize="22"/>
                <Label Content="(khách hàng)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                Grid.ColumnSpan="3"
                Grid.Column="0"
                Grid.Row="1"
                Height="250"                        
                Margin="10,0,90,20" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <lvc:CartesianChart 
                            BorderBrush="Brown"
                            Background="White"                           
                            FontSize="10"                            
                            Foreground="Black"
                            FontWeight="Bold"
                            VerticalContentAlignment="Top"                           
                            LegendLocation="Top"
                           >
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Name="columnChartName"      
                                  Title="Doanh thu mỗi tháng"
                                  FontSize="8"
                                  Values="{Binding Values}"
                                  MaxColumnWidth = "20"
                                  ColumnPadding = "5"
                                  DataLabels = "True"
                                  >
                    </lvc:ColumnSeries>
                    
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.ChartLegend>
                    <lvc:DefaultLegend BulletSize="0" 
                                   Margin="0,0,30,0"
                                   Foreground="Gray"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                </lvc:CartesianChart.ChartLegend>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title=""                         
                          FontSize="9"                         
                          FontWeight="Medium"
                          HorizontalAlignment="Center"
                          Labels ="{Binding Labels}"
                          >
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"                                     
                                       IsEnabled="False" 
                                       Margin="0,0,20,0"
                                        Width="10"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>

                <lvc:CartesianChart.AxisY >
                    <lvc:Axis Title=""
                          Labels ="{Binding Values}" >
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="True"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>

                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Border>


        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Height="250"
                Width="250"                        
                Margin ="110,0,10,20" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <lvc:PieChart Name="DoughNut" 
                      Background="White"
                      Foreground="Black"                    
                     
                      InnerRadius="60"
                      LegendLocation="Bottom"
                      
                      FontSize="9"
                     >
                <lvc:PieChart.Series>
                    <lvc:PieSeries Name="pieChart1"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                    <lvc:PieSeries Name="pieChart2"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                    <lvc:PieSeries Name="pieChart3"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                    <lvc:PieSeries Name="pieChart4"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                </lvc:PieChart.Series>
            </lvc:PieChart>
        </Border>
        
        <ComboBox Name="YearCombobox"
                  Text="2023"
                  Grid.Column="0"
                  Grid.Row="1"
                  Width="60"
                  Height="30"
                  VerticalAlignment="Top"
                  Style="{StaticResource ComboBoxFlatStyle}"
                  SelectionChanged="YearCombobox_SelectionChanged">
            <ComboBoxItem Content="2021"/>
            <ComboBoxItem Content="2022"/>
            <ComboBoxItem Content="2023"/>
            <ComboBoxItem Content="2024"/>
        </ComboBox>
    </Grid>
</UserControl>
