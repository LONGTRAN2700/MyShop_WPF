<UserControl x:Class="BookStoreManagement.Orders.OrdersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement.Converter"
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="Order_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="460"/>
        </Grid.RowDefinitions>

        <Border Name="Border"
                Background="White"
                CornerRadius="5"
                BorderThickness="1"
                VerticalAlignment="Top"
                Grid.Row="1"                
                Width="660"
                Height="50">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="5"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!--Cột Mã đơn hàng-->
                <TextBlock Text="🔑 Mã ĐH"
                   Height="30"
                   FontSize="11"
                   TextAlignment="Center"
                   FontWeight="Medium"
                   Padding="0,10,0,0"
                   Width="75"
                   Margin="0,0,0,0"
                   Background="Transparent"/> 

                <!--Cột khách hàng-->
                <TextBlock Text="🙎🏼‍ Khách hàng"
                       TextAlignment="Center"
                       FontSize="11"
                       FontWeight="Medium"
                       Height="30"
                       Width="80"
                       Padding="0,10,0,0"
                       Margin="40,0,5,0"
                       Background="Transparent"/>

                <!--Cột thời gian-->
                <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="60,0,5,0"
                        Background="Transparent">
                    <TextBlock Text="🗓 Ngày đặt"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="70"
                           Background="Transparent"/>
                    <ComboBox Name="OrderDateCombobox"
                          Margin="0,0,0,0" Width="45" 
                          FontSize="12"
                          FontWeight="Bold"
                          SelectionChanged="OrderDate_SelectionChanged"
                          Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem Content="⚙ Mặc định" 
                                  FontSize="12"
                                  FontWeight="Bold"/>
                        <ComboBoxItem Content="⏫ Mới nhất" 
                                  FontSize="12"
                                  FontWeight="Bold"/>
                        <ComboBoxItem Content="⏬ Cũ nhất"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    </ComboBox>
                </StackPanel>

                <!--Cột trạng thái-->
                <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="25,0,5,0"
                        >
                    <TextBlock Text="⌛ Trạng thái"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="70"
                           Background="Transparent"/>
                    <ComboBox Name="StatusCombobox"
                          Margin="0,0,0,0" Width="45" 
                          FontSize="12"
                          FontWeight="Bold"
                           SelectionChanged="StatusCombobox_SelectionChanged"
                          Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem Content="⚙ Mặc định" 
                                 FontSize="12"
                                 FontWeight="Bold"/>
                        <ComboBoxItem Content="🚚 Đang giao hàng" 
                                 FontSize="12"
                                 FontWeight="Bold"/>
                        <ComboBoxItem Content="🔄 Đang xử lí"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                        <ComboBoxItem Content="✅ Đã giao thành công"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                        <ComboBoxItem Content="❌ Hủy đơn"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    </ComboBox>
                </StackPanel>

                <!--Cột tổng tiền-->
                <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="10,0,5,0"
                        >
                    <TextBlock Text="💴 Tổng tiền"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

                </StackPanel>
            </StackPanel>
        </Border>

        <ListView Name="OrderList" 
                  Margin="30,50,30,90"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1,2,1,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="3, 1, 3, 1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border 
                          CornerRadius="5"  
                          BorderThickness="0.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0, 7, 0, 7"
                          Height ="45"
                          Width="650"
                          Background="LightGreen"
                          BorderBrush="Transparent">
                        <Border.Effect>
                            <DropShadowEffect
                    Color="Gray"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="5"
                    Opacity="0.5" />
                        </Border.Effect>
                        <Button Name="detailOrderButton"
                                Background="Transparent"
                            Click="detailOrderButton_Click"
                            Style="{StaticResource RoundedButtonStyle}">
                            <StackPanel Margin="0, 0, 0, 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="650">
                                <!--Mã hóa đơn-->
                                <TextBlock x:Name="txtOrderID" 
                                       Width="65"
                                       TextAlignment="Center"
                                        
                                       FontSize="11" 
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium">
                                    <Run Text="DH"/>-<Run Text="{Binding OrderId}"/>
                                </TextBlock>

                                <!--Tên khách hàng-->
                                <TextBlock Text="{Binding CustomerName}"
                                       FontSize="11"
                                       Width="180"
                                       Margin="0, 0, 0, 0"
                                       TextAlignment="Center"
                                       FontWeight="Medium"/>

                                <!--Thời gian-->
                                <TextBlock Text="{Binding OrderDate}"
                                       FontSize="11"
                                       Width="130"  
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                                <!--Trạng thái-->
                                <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Width="100"                                      
                                       TextAlignment="Center"
                                       Margin="35, 0, 10, 0"
                                       FontWeight="Medium"/>

                                <!--Tổng tiền-->
                                <TextBlock Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}"
                                       FontSize="11"
                                       Width="140"
                                       Foreground="Brown"
                                       TextAlignment="Center"
                                       Margin="0, 0, 10, 0"
                                       FontWeight="Medium"
                                       />
                            </StackPanel>
                        </Button>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <StackPanel Orientation="Horizontal"
                    Margin="65, 10,0,0"
                    HorizontalAlignment="Left"                    
                    Height="30">
            <Button x:Name="AddOrder"
                    Content="➕Tạo đơn hàng" 
                    Width="95"
                    Height="30"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Background="LightGreen"
                    FontSize="11"
                    FontWeight="Medium"
                    Margin="0, 0, 5, 0"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Click="AddOrder_Click"/>
            <Border 
                CornerRadius="5"  
                BorderThickness="1"
                Background="White"
                Margin="205,0,0,0">
                <Border.Effect>
                    <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="1"
                    BlurRadius="10"
                    Opacity="0.5" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Ngày bắt đầu:"
                           FontSize="9"
                           Height="25"
                           
                           FontWeight="Medium"/>
                    <DatePicker Name="StartDatePicker" 
                                FontSize="10"
                                Height="25"
                                BorderBrush="Transparent"
                                Width="100" 
                                IsTodayHighlighted="True"
                                SelectedDateChanged="StartDatePicker_SelectedDateChanged">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <TextBox x:Name="PART_TextBox" 
                                                     Text="{Binding Path=SelectedDate, 
                                                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, 
                                                            StringFormat={}{0:yyyy/MM/dd}}" 
                                                      BorderBrush="Transparent"
                                                      Padding="0,1,0,0"
                                                      IsEnabled="False"
                                                      FontWeight="Bold"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>
            </Border>

            <Border 
                CornerRadius="5"  
                BorderThickness="1"
                Background="White"
                Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="1"
                    BlurRadius="10"
                    Opacity="0.5" />
                </Border.Effect>
                <StackPanel  Orientation="Horizontal">
                    <Label Content="Ngày kết thúc:"
                           FontSize="9"
                           Height="25"
                           FontWeight="Medium"/>
                    <DatePicker Name="EndDatePicker" Margin="0"
                                Width="100"
                                Height="25"
                                FontSize="10"
                                BorderBrush="Transparent"
                                IsTodayHighlighted="True"
                                SelectedDateChanged="EndDatePicker_SelectedDateChanged">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <TextBox x:Name="PART_TextBox" 
                                                     Text="{Binding Path=SelectedDate, 
                                                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, 
                                                            StringFormat={}{0:yyyy/MM/dd}}" 
                                                      BorderBrush="Transparent"
                                                      Padding="0,1,0,0"
                                                      IsEnabled="False"
                                                      FontWeight="Bold"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>
            </Border>

            
            <Button Name="ReloadButton" 
                    Height="25" 
                    Width="25"
                    Background="White"
                    BorderThickness="1"
                    Click="Reload_Click"
                    Style="{StaticResource RoundedButton}"
                    Margin="10,0,0,0">
                <Image Source="../../../Images/Orders/reload.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Height="15"
                       Width="15" 
                       />
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="50">
            <Button Content="◀" 
                    Click="Previous_Click" 
                    FontSize="14"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    Margin="0, 0, 0, 0"
                    Width="25" 
                    Height="25"/>

            <TextBlock x:Name="PageInfo" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"                           
                           TextAlignment="Center"
                           Padding="2, 8, 0, 0"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="30"
                           Height="30"/>

            <Button Content="▶" 
                    Click="Next_Click"
                    Background="Transparent"
                    BorderBrush="Red"
                    BorderThickness="2, 2, 2, 2"
                    FontSize="14"
                    Width="25"
                    Height="25"/>

        </StackPanel>
    </Grid>
</UserControl>
