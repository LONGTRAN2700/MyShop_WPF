<UserControl x:Class="BookStoreManagement.Orders.DetailOrderWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement.Converter"
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="DetailOrder_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="340"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                   Margin="0,0,0,130"
                   Orientation="Horizontal">
            <Button x:Name="BackButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 15 ,0, 0 "
                Width="30"
                Height="30"
                Background="Transparent"
                BorderBrush="Transparent"
                FontSize="40"
                FontWeight="Bold"
                Style="{StaticResource CustomButtonTemplate}"
                Click="BackButton_Click">
                <Image Source="../../../Images/Products/back.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>

            <Button Name="DeleteOrder"
                Content="Xóa"
                FontWeight="Bold"
                FontSize="9"
                Click="DeleteOrder_Click"
                Width="45"
                Height="25"
                HorizontalAlignment="Right"
                Margin="590,0,0,0"       
                Foreground="Brown"
                Style="{StaticResource RoundedButtonStyle}">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        
                        <GradientStop Color="#FFEEEFF4" Offset="1"/>
                        <GradientStop Color="#FFDFF3F1" Offset="0.52"/>
                        <GradientStop Color="#FFA0F8F0" Offset="0"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button Name="UpdateOrder"
                Content="Sửa"
                FontSize="9"
                FontWeight="Bold"
                Click="UpdateOrder_Click"
                Width="45"
                Height="25"
                HorizontalAlignment="Right"
                Margin="10,0,0,0"       
                Foreground="Brown"
                Style="{StaticResource RoundedButtonStyle}">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFEEEFF4" Offset="1"/>
                        <GradientStop Color="#FFDFF3F1" Offset="0.52"/>
                        <GradientStop Color="#FFA0F8F0" Offset="0"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
       
        <StackPanel Grid.Row="0"  
                    Margin="60, 50, 0, 0">
            <!--Chứa các thuộc tính còn lại của sách-->
            <StackPanel Margin="0, 0, 0, 0">
                <!--Hiển thị mã đơn hàng-->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Label Content="Mã đơn hàng:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="90"/>
                    <TextBox Name="txtOrderId"
                             Text="{Binding OrderId}" 
                              FontWeight="Medium"
                             BorderBrush="Red"
                             FontSize="12"
                             Padding="4, 5, 0 , 0"
                             TextAlignment="Left"    
                             Background="Transparent"                               
                             BorderThickness="0,0,0,0"
                             Width="200"
                             IsEnabled="False"
                             TextWrapping="Wrap"/>

                    <Label Content="Ngày tạo:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="70"/>
                    <TextBox Name="txtOrderDate"
                             Text="{Binding OrderDate}" 
                             FontWeight="Medium"
                             BorderBrush="Red"
                             FontSize="12"
                             Padding="4, 5, 0 , 0"
                             TextAlignment="Left"    
                             Background="Transparent"
                               
                             BorderThickness="0,0,0,0"
                             Width="200"
                             IsEnabled="False"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Hiển thị khách hàng -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Label Content="Khách hàng:"
                           Foreground="Gray"
                           Background="Transparent"
                           BorderThickness="0,0,0,0"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="90"/>
                    <TextBox Name="txtCustomerName"
                             Text="{Binding CustomerName}" 
                             Padding="4,5,0,0"
                             Background="Transparent"
                             FontWeight="Medium"
                             BorderBrush="Red"
                             BorderThickness="0,0,0,0"
                             FontSize="12"
                             Width="300"
                             IsEnabled="False"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Hiển thị trạng thái -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Label Content="Trạng thái:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="90"/>
                    <ComboBox Name="txtStatus"
                              Text="{Binding Status}" 
                              FontWeight="Medium"
                              BorderBrush="Red"
                              FontSize="12"
                              Padding="10, 5, 0 , 0"                                                           
                              Width="170"
                              IsEnabled="False"
                              Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem Content="Đang xử lí"/>
                        <ComboBoxItem Content="Đang giao hàng"/>
                        <ComboBoxItem Content="Đã giao thành công"/>
                        <ComboBoxItem Content="Hủy đơn"/>
                    </ComboBox>
                </StackPanel>

                <!-- Hiển thị tổng tiền-->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Label Content="Tổng tiền:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="90"/>
                    <TextBox Name="txtTotalAmount"
                             Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}"
                             FontWeight="Medium"
                             BorderBrush="Red"
                             Background="Transparent"
                             BorderThickness="0,0,0,0"
                             FontSize="12"
                             Padding="4, 5, 0 , 0"
                             TextAlignment="Left"                              
                             Width="300"
                             IsEnabled="False"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
     
        <!--Header từng thuộc tính-->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Height="50"
                    Width="670"
                    Margin="0,0,0,0"
                    Orientation="Horizontal">
            <!--Cột tên sản phẩm-->
            <TextBlock Text="Tên sản phẩm"
                       TextAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Height="30"
                       Width="80"
                       Padding="0,10,0,0"
                       Margin="85,0,5,0"
                       Foreground="Brown"
                       Background="Transparent"/>

            <!--Cột đơn giá-->
            <TextBlock Text="Đơn giá"
                       TextAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Padding="0,10,0,0"
                       Height="30"
                       Width="50"
                       Margin="120, 0,0,0"
                       Foreground="Brown"
                       Background="Transparent"/>


            <!--Cột số lượng -->
            <TextBlock Text="Số lượng"
                           TextAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="50"
                           Margin="50,0,0,0"
                       Foreground="Brown"
                           Background="Transparent"/>

            <!--Cột thành tiền-->
            <TextBlock Text="Thành tiền"
                           TextAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="60"
                           Margin="55,0,0,0"
                           Foreground="Brown"
                           Background="Transparent"/>
        </StackPanel>

        <ListView Name="DetailOrderList" 
                  Margin="60,40,60,60"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Brown"
                  BorderThickness="1,2,1,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Margin="20,12, 20, 0"
                                 Orientation="Horizontal"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Height ="30"
                                 Width="670"
                                 Background="LightGreen">
                        <!--Tên sản phẩm-->
                        <TextBlock Text="{Binding ProductName}"
                                       FontSize="11"
                                       Width="250"
                                       Margin="5, 0, 0, 0"
                                       TextAlignment="Center"
                                    VerticalAlignment="Center"
                                       FontWeight="Medium"/>

                        <!--Đơn giá-->
                        <TextBlock Text="{Binding UnitPrice, Converter={StaticResource MoneyConverter}}"
                                       FontSize="11"
                                       Width="100"
                                   VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="10, 0, 0, 0"
                                       FontWeight="Medium"/>

                        <!--Số lượng-->
                        <TextBlock Text="{Binding Quantity}"
                                       FontSize="11"
                                       Width="70"
                                   VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="15, 0, 0, 0"
                                       FontWeight="Medium"/>

                        <!--Thành tiền-->
                        <TextBlock Text="{Binding Price, Converter={StaticResource MoneyConverter}}"
                                       FontSize="11"
                                       Width="150"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


    </Grid>
</UserControl>
