<UserControl x:Class="BookStoreManagement.Customers.DetailCustomer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement.Converter"
             mc:Ignorable="d" 
             Height="530" Width="790">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,0"
                    Grid.Row="0"
                   Orientation="Horizontal">
            <Button x:Name="BackButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 15 ,0, 0 "
                Width="30"
                Height="30"
                Background="Transparent"
                BorderBrush="Transparent"
                FontSize="40"
                FontWeight="Bold"
                Style="{StaticResource CustomButtonTemplate}"
                Click="BackButton_Click">
                <Image Source="../../../Images/Products/back.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <TextBlock Text="THÔNG TIN KHÁCH HÀNG"
                       FontSize="22"
                       FontWeight="medium"
                       Margin="200,10,0,0"/>
        
        </StackPanel>

        <StackPanel Margin="0, 50, 0, 0"
                    Grid.Row="1"
                    HorizontalAlignment="Center" 
                     VerticalAlignment="Top"
                    Width="460" Height="300">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="71" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <!-- Mã khách hàng -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Mã khách hàng:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBox  Name="txtCustomerID"
                              Text="{ Binding CustomerID}"
                              Width="200" Height="30"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              IsEnabled="False"
                              HorizontalAlignment="Left"
                              Style="{StaticResource FlatTextBox}" 
                              Background="Transparent"/>
                </StackPanel>


                <!-- Tên khách hàng -->
                <StackPanel Margin="10, 0, 0, 0" Grid.Row="0" Grid.Column="1"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Tên khách hàng:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorCustomerName"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtCustomerName"
                             Text="{Binding Name}"
                                 Width="224" Height="30"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Margin="4 0 0 0"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource FlatTextBox}"/>
                </StackPanel>


                <!-- Địa chỉ-->
                <StackPanel Grid.Row="1" Grid.Column="1"
                            
                            Margin="10, 15, 0, 0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Địa chỉ:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorAddress"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                    Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtAddress"
                             Text="{Binding Address}"
                             Width="224" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                             Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                </StackPanel>

                <!-- Giới tính -->
                <StackPanel Margin="0, 15, 0, 0" 
                            Grid.Row="1" Grid.Column="0"
                             >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Giới tính:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorSex"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                     Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <ComboBox Name="txtSex"
                              Text="{Binding Sex}"
                              Height="30"
                              Width="100" 
                              FontSize="12"
                              FontWeight="Medium"
                              HorizontalAlignment="Left"
                              Margin="4,0,0,0"
                              Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem>Nam</ComboBoxItem>
                        <ComboBoxItem>Nữ</ComboBoxItem>

                    </ComboBox>

                </StackPanel>

                <!-- Số điện thoại -->
                <StackPanel Grid.Row="2" Grid.Column="0"

                            Margin="0, 15, 0, 0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Số điện thoại:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorPhone"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                    Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtPhone"
                             Text="{Binding Phone}"
                             Width="200" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                              Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="10, 15 , 0, 0" Grid.Row="2" Grid.Column="1"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Email:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorEmail"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                     Width="107"
                                   Visibility="Hidden"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox  Name="txtEmail"
                              Text="{Binding Email}"
                              Width="224" Height="30"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource FlatTextBox}" 
                              Background="Transparent"/>
                </StackPanel>
            </Grid>
            <Button Name="updateButton" Content="Cập nhật"
                    Height="35"
                   
                    FontWeight="Bold"
                    Style="{StaticResource FlatButton}"
                    Margin="0, 25, 0 ,0" Click="updateButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
