<UserControl x:Class="BookStoreManagement.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement.Converter"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="DashBoard_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resource/UIResource.xaml"/>
                <ResourceDictionary Source="../../../Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Số lượng sản phẩm đang bán-->
        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="0" Grid.Row="0"
                Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="10,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel >
                <Label Content="PRODUCTS  📖"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                      
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblProduct"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(sản phẩm đang bán)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

            </StackPanel>
        </Border>


        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="1" Grid.Row="0"
                Height="100" 
                Width="160"
               Background="Aqua"
               VerticalAlignment="Top"
                Margin="5,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel Name="OrderStackPanel">
                <Label Content="ORDERS  📦"
                        FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

                <TextBlock Name="tblOrderQuantity"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(đơn hàng trong tuần)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!--Sắp hết hàng-->
        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="2" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="Cornsilk"
                VerticalAlignment="Top"
                Margin="0,20,10,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="RUNNING OUT OF STOCK  📛"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblStock"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(SL dưới 5)"
                       FontSize="8"
                       Foreground="Gray"                     
                       Margin="10,0,0,0"/>
                <Border 
                CornerRadius="5"  
                BorderBrush="LightGray" 
                BorderThickness="2"
                Background="White"
                Width="17"
                Height="17"
                HorizontalAlignment="Left"
                Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect
                    Color="Brown"
                    Direction="320"
                    ShadowDepth="1"
                    BlurRadius="10"
                    Opacity="0.2" />
                    </Border.Effect>
                    <Button Name="ShowButton"  Content="🔻"
                        FontSize="8"
                        Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderBrush="Transparent" Margin="0,0,0,-1"
                        Click="ShowButton_Click"
                        />
                </Border>
            </StackPanel>
        </Border>


        <!--Số lượng khách hàng-->
        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="3" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="Khaki"
                VerticalAlignment="Top"
                Margin="0,20,25,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="CUSTOMER  🙎🏼‍"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblCustomer"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="medium"
                           FontSize="22"/>
                <Label Content="(khách hàng)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                Grid.ColumnSpan="3"
                Grid.Column="0"
                Grid.Row="1"
                Height="250"                        
                Margin="10,0,90,20" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <lvc:CartesianChart 
                            BorderBrush="Brown"
                            Background="White"                           
                            FontSize="10"                            
                            Foreground="Black"
                            FontWeight="Bold"
                            VerticalContentAlignment="Top"                           
                            LegendLocation="Top"
                           >
                <lvc:CartesianChart.Series>
                    <lvc:ColumnSeries Name="columnChartName"      
                                  Title="{Binding Title}"
                                  Values="{Binding Values}"
                                  FontSize="8"                                
                                  MaxColumnWidth = "20"
                                  ColumnPadding = "5"
                                  DataLabels = "True">
                    </lvc:ColumnSeries>

                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.ChartLegend>
                    <lvc:DefaultLegend BulletSize="0" 
                                   Margin="0,0,30,0"
                                   Foreground="Red"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                </lvc:CartesianChart.ChartLegend>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title=""                         
                          FontSize="9"                         
                          FontWeight="Medium"
                          HorizontalAlignment="Center"
                          Labels ="{Binding Labels}"
                          >
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"                                     
                                       IsEnabled="False" 
                                       Margin="0,0,20,0"
                                        Width="10"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>

                <lvc:CartesianChart.AxisY >
                    <lvc:Axis Title=""
                          Labels ="{Binding Values}" >
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="True"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>

                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Border>


        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Height="250"
                Width="250"                        
                Margin ="110,0,10,20" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label 
                    Content="Tình trạng đơn hàng"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="Red"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"/>
                <lvc:PieChart Name="DoughNut" 
                      Background="White"
                      Foreground="Black"                                        
                      InnerRadius="50"
                      LegendLocation="Bottom"                      
                      FontSize="9"
                      Height="220"
                      Margin="0,0,0,0">
                    <lvc:PieChart.Series>
                        <lvc:PieSeries Name="pieChart1"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                        <lvc:PieSeries Name="pieChart2"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                        <lvc:PieSeries Name="pieChart3"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                        <lvc:PieSeries Name="pieChart4"
                               Values="{Binding Values}"
                               Title="{Binding Title}"
                               DataLabels="True"/>
                    </lvc:PieChart.Series>
                </lvc:PieChart>
            </StackPanel>

        </Border>

        <Border 
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                Grid.Column="0"
                Grid.Row="1"
                Width="70"
                Height="30"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,0,0,0"
                Background="White">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <ComboBox Name="YearCombobox" 
                  ItemsSource="{Binding years}"
                  FontWeight="Medium"
                  
                  Style="{StaticResource ComboBoxFlatStyle}"
                  SelectionChanged="YearCombobox_SelectionChanged">
            </ComboBox>
        </Border>

        <!--Top 5 sản phẩm sắp hết hàng-->
        <Border Name ="Border_Top5OutOfStock"
                CornerRadius="5"  
                BorderBrush="Gray" 
                BorderThickness="1.5"
                HorizontalAlignment="Left"
                Grid.Column="2"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Height="320" 
                Width="320"
                Background="AntiqueWhite"
                VerticalAlignment="Top"
                Margin="25,115,25,0"
                Visibility="Hidden">
          
            <StackPanel 
                    >
                <Label Content="TOP NHỮNG CUỐN SÁCH SẮP HẾT HÀNG"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="Green"
                       HorizontalAlignment="Center"/>
                <Label Content="SL tồn" 
                       FontSize="9"
                       Height="20"
                       FontWeight="Medium"
                       HorizontalAlignment="Right"
                       Margin="0,0,22,0"/>
                <ListView
                    Name="StackPanel_Top5RunOutOfStock" 
                    Margin="5,0,5,5"
                    Height="280" 
                    Width="300"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1,2,1,2"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemContainerStyle >
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="Red" />
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1, 1, 1, 1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Name="detailProductButton"
                                    Background="Transparent"
                                    BorderBrush="Brown"
                                    BorderThickness="-1,0,-1,0"
                                    Click="detailProduct_Click"
                                    Height="50"
                                    Style="{StaticResource RoundedButtonStyle}">
                                <StackPanel Margin="0, 0, 0, 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="350">
                                    <!--Hình ảnh sách -->
                                    <Image x:Name="txtIamge" 
                                           Source="{Binding ImageURL, Converter={StaticResource AbsoluteConverter}}"
                                           Width="45"
                                           Height="50"
                                           Margin="15, 0, 0, 3"
                                           HorizontalAlignment = "Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                    </Image>
                                    <!--Tên sách-->
                                    <TextBlock Text="{Binding BookName}"
                                       FontSize="10"
                                       Width="120"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="10, 0, 0, 10"
                                       FontWeight="Medium"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"/>

                                    <!--Giá cả-->
                                    <TextBlock Text="{Binding Price, Converter={StaticResource MoneyConverter}}"
                                       FontSize="10"
                                       Width="50"  
                                       TextAlignment="Left"
                                       
                                       VerticalAlignment="Bottom"
                                       Margin="10, 0, 0, 10"
                                      />
                                    <!--Số lượng tồn kho-->
                                    <TextBlock Text="{Binding Quantity}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Width="30"  
                                       TextAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="15, 0, 0, 10"
                                      />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
