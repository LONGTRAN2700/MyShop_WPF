<UserControl x:Class="BookStoreManagement.Customers.CustomersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             d:DesignHeight="530" d:DesignWidth="790" Loaded="Customer_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="450"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Height="50"
                    Orientation="Horizontal">
            <!--Cột Mã khách hàng-->
            <TextBlock Text="Mã khách hàng"
                   Height="30"
                   FontSize="11"
                   TextAlignment="Center"
                   FontWeight="Medium"
                   Padding="0,10,0,0"
                   Width="75"
                   Margin="65,0,0,0"
                   Background="Transparent"/>

            <!--Cột tên khách hàng-->
            <TextBlock Text="Tên khách hàng"
                       TextAlignment="Center"
                       FontSize="11"
                       FontWeight="Medium"
                       Height="30"
                       Width="80"
                       Padding="0,10,0,0"
                       Margin="40,0,5,0"
                       Background="Transparent"/>

            <!--Cột giới tính-->
            <StackPanel Orientation="Horizontal"
                        Width="60"
                        Height="30"
                        Margin="60,0,5,0"
                        >
                <TextBlock Text="Giới tính"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="60"
                           Background="Transparent"/>
                
            </StackPanel>

            <!--Cột địa chỉ-->
            <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="25,0,5,0"
                        >
                <TextBlock Text="Địa chỉ"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="70"
                           Background="Transparent"/>
               
            </StackPanel>

            <!--Cột Email-->
            <StackPanel Orientation="Horizontal"
                        Width="90"
                        Height="30"
                        Margin="10,0,5,0"
                        >
                <TextBlock Text="Email"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

            </StackPanel>

            <!--Cột SDT-->
            <StackPanel Orientation="Horizontal"
                        Width="90"
                        Height="30"
                        Margin="10,0,5,0"
                        >
                <TextBlock Text="SĐT"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

            </StackPanel>
        </StackPanel>

        <ListView Name="CustomerList" 
                  Margin="10,50,10,40"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1,2,1,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="3, 1, 3, 1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Name="detailCustomerButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0, 7, 0, 7"
                            Height ="45"
                            Width="650"
                            Background="LightGreen"
                            BorderBrush="Transparent"                           
                            
                            Style="{StaticResource RoundedButtonStyle}">
                        <StackPanel Margin="0, 0, 0, 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="650">
                            <!--Mã khách hàng-->
                            <TextBlock x:Name="txtCustomerID" 
                                       Width="65"
                                       TextAlignment="Center"
                                       Text="{Binding CustomerID}" 
                                       FontSize="11"  
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                            <!--Tên khách hàng-->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="11"
                                       Width="180"
                                       Margin="0, 0, 0, 0"
                                       TextAlignment="Center"
                                       FontWeight="Medium"/>

                            <!--Giới tính-->
                            <TextBlock Text="{Binding Sex}"
                                       FontSize="11"
                                       Width="130"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                            <!--Địa chỉ-->
                            <TextBlock Text="{Binding Address}"
                                       FontSize="11"
                                       Width="100"
                                       TextAlignment="Center"
                                       Margin="35, 0, 10, 0"
                                       FontWeight="Medium"/>

                            <!--Email-->
                            <TextBlock Text="{Binding Email}"
                                       FontSize="11"
                                       Width="140"
                                       TextAlignment="Center"
                                       Margin="0, 0, 10, 0"
                                       FontWeight="Medium"
                                       />

                            <!--SDT-->
                            <TextBlock Text="{Binding Phone}"
                                       FontSize="11"
                                       Width="140"
                                       TextAlignment="Center"
                                       Margin="0, 0, 10, 0"
                                       FontWeight="Medium"
                                       />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
