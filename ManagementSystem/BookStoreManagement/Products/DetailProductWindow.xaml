<UserControl x:Class="BookStoreManagement.Products.DetailProductWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="DetailProduct_Loaded">
    <UserControl.Resources>
       
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Label Content="Thông tin về sách"
               Grid.Row="0"
               Grid.ColumnSpan="3"
               FontSize ="24"
               FontWeight="Medium"
               Foreground="Green"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin ="0, 0, 50, 0"/>
        <!-- Hiển thị hình ảnh -->
        <Border CornerRadius="5" 
                BorderBrush="Black"
                BorderThickness="2"
                Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
               HorizontalAlignment="Right"
               Margin="0, 40,0,0"
                Height="270"
               Width="190"

               VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    BlurRadius="20"
                    Opacity="0" />
            </Border.Effect>
            <Image Source="{Binding ImageURL, Converter={StaticResource AbsoluteConverter}}" 
               Height="270"
               Width="200"/>
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="1" 
                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Margin="25, 40, 0, 0">
            <StackPanel >
                <StackPanel HorizontalAlignment="Left">
                    <!-- Hiển thị tên sách -->
                    <TextBlock Text="{Binding BookName}" 
                       FontSize="22"
                       FontWeight="Medium"
                       Margin ="4, 5, 0, 0"
                       HorizontalAlignment="Center"/>
                    <!-- Hiển thị giá -->
                    <TextBlock Name="txtPrice" 
                           Text="{Binding Price, Converter={StaticResource MoneyConverter}, Mode=TwoWay}"
                           Margin="0, 10, 0, 0"
                           HorizontalAlignment="Center"
                           Foreground="Red"
                           FontWeight="Medium"
                           FontSize="16"
                           TextDecorations="Underline"
                           FontFamily="Arial"/>
                </StackPanel>
            </StackPanel>
            <!--Chứa các thuộc tính còn lại của sách-->
            <StackPanel Margin="0, 30, 0, 0">
                <!--Hiển thị tên tác giả-->
                <StackPanel Orientation="Horizontal">
                    <Label Content="👨🏼‍💼 Tác giả:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBlock Name="txtAuthor"
                               Text="{Binding Author, Mode=TwoWay}" 
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               TextWrapping="Wrap"/>

                </StackPanel>
                
                <!-- Hiển thị loại sách -->
                <StackPanel Orientation="Horizontal" >
                    <Label Content="🏷 Thể loại:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBlock Name="txtCategoryName"
                               Text="{Binding CategoryName, Mode=TwoWay}"                              
                               Foreground="Gray"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="300"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Hiển thị số lượng -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="🧮 Số lượng:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBlock Name="txtQuantity"
                               Text="{Binding Quantity , Mode=TwoWay}" 
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Hiển thị mô tả -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="📝 Mô tả:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBlock Name="txtDescription"
                               Text="{Binding Description, Mode=TwoWay}" 
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               TextWrapping="Wrap"/>

                    

                </StackPanel>

                
            </StackPanel>
           
        </StackPanel>
        
        <!-- Hiển thị Id -->
        <TextBlock Name="txtBookID" Text="{Binding BookId}" 
                   Grid.Column="0" 
                   Grid.Row="1"
                   Visibility="Hidden"/>
        <TextBlock Name="txtCategoryId" Text="{Binding CategoryId}" 
                   Grid.Column="0" 
                   Grid.Row="1"
                   Visibility="Hidden"/>
        <Button x:Name="BackButton"
                Grid.Column="0"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 15 ,0, 0 "
                Width="30"
                Height="30"
                Background="Transparent"
                BorderBrush="Transparent"
                FontSize="40"
                FontWeight="Bold"
                Style="{StaticResource CustomButtonTemplate}"
                Click="BackButton_Click">
            <Image Source="../Images/Products/back.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0, 0, 25, 10">
            <Button Name="UpdateButton"
                    Content=" Sửa"
                    Width="50"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="Coral"
                    BorderBrush="Transparent"
                    FontWeight="Bold"
                    Style="{StaticResource RoundedButtonStyle}" Click="UpdateButton_Click"/>

            <Button Name="DeleteButton"
                    Content="Xóa"
                    Width="50"
                    Height="30"
                    Background="BurlyWood"
                    BorderBrush="Transparent"
                    FontWeight="Bold"
                    Style="{StaticResource RoundedButtonStyle}" Click="DeleteButton_Click"/>
        </StackPanel>

       
    </Grid>
</UserControl>
