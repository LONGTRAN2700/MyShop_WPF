<Window x:Class="BookStoreManagement.Products.UpdateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        mc:Ignorable="d"
        Title="UpdateProductWindow" Height="458" Width="690" Loaded="UpdateWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <!-- Hiển thị hình ảnh -->
        <Image Source="{Binding ImageURL, Converter={StaticResource AbsoluteConverter}}" 
               Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
               Margin ="25, 10, 0, 0"
               Height="270"
               Width="200"
               VerticalAlignment="Top"/>
        <StackPanel Grid.Row="0" Grid.Column="1" 
                    Grid.ColumnSpan="2" Grid.RowSpan="3"
                    Margin="15, 35, 0, 0">
            
            <StackPanel >
                <StackPanel HorizontalAlignment="Left">
                    <!-- Hiển thị tên sách -->
                    <TextBlock Name="txtName"
                               Text="{Binding BookName}" 
                               FontSize="22"
                               FontWeight="Medium"
                               Margin ="4, 10, 0, 0"
                               Width="300"
                               HorizontalAlignment="Center"/>
                    <!-- Hiển thị giá -->
                    <TextBox Name="txtPrice"
                        Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                           Margin="4, 10, 0, 0"
                           HorizontalAlignment="Left"
                           Foreground="Red"
                           FontWeight="Medium"
                           FontSize="16"
                           Width="200"
                             Height="30"
                           BorderBrush="Transparent"
                           FontFamily="Arial"
                           
                           Style="{StaticResource FlatTextBox}"/>
                </StackPanel>


            </StackPanel>
            <!--Chứa các thuộc tính còn lại của sách-->
            <StackPanel Margin="0, 30, 0, 0">
                <!--Hiển thị tên tác giả-->
                <StackPanel Orientation="Horizontal"
                            Margin="0, 0, 0, 10">
                    <Label Content="👨🏼‍💼 Tác giả:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBox Name="txtAuthor" 
                             Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <!-- Hiển thị loại sách -->
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,0,10">
                    <Label Content="🏷 Thể loại:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <ComboBox  Name="txtCategoryName" 
                               Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="Gray"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="100"                               
                               Style="{StaticResource ComboBoxFlatStyle}"/>
                </StackPanel>

                <!-- Hiển thị số lượng -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="🧮 Số lượng:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"/>
                    <TextBox Name="txtQuantity"
                               Text="{Binding Quantity ,UpdateSourceTrigger=PropertyChanged}" 
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Hiển thị mô tả -->
                <StackPanel Orientation="Horizontal"
                            Margin="0, 5, 0, 0" Height="78">
                    <Label Content="📝 Mô tả:"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="Medium"
                           Width="80"
                           />
                    <TextBox Name="txtMota"
                               Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="Gray"
                               FontSize="12"
                               Padding="0, 5, 0 , 0"
                               TextAlignment="Left"                              
                               Width="300"
                               Height="70"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Button Name="SaveButton" 
                Content="Lưu lại" 
                Background="AliceBlue"
                FontWeight="Medium"
                FontSize="14"
                Height="35" 
                Width="100"
                Grid.Column="1"
                Grid.Row="3" Click="SaveButton_Click"
                Style="{StaticResource RoundedButtonStyle}"/>
    </Grid>
</Window>
