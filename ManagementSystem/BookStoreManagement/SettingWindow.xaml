<Window x:Class="BookStoreManagement.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="SettingWindow" Height="280" Width="450" Loaded="Setting_Loaded"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/UIResource.xaml"/>
                <ResourceDictionary Source="Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF1DF4F4"/>
                <GradientStop Color="#FF37F4F4" Offset="1"/>
                <GradientStop Color="#FFB0FFFF" Offset="0.492"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="135"/>
        </Grid.RowDefinitions>

        <Border Name="Setting01"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                Grid.Row="0"
                Height="40"
                Background="White"
                Margin="20,20,20,0">
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel 
                     Orientation="Horizontal">
                <Label Content="Số lượng sản phẩm mỗi trang: "
                   FontSize="12"
                   FontWeight ="Medium"
                   VerticalContentAlignment="Center"     
                   Height="30"
                   Width="190"/>
                <Button x:Name="subProductButton"
                    Width ="20"
                    Height="20"
                    Background="Transparent"                  
                    BorderBrush="Transparent"
                    Foreground="Brown"
                    Content ="➖"
                    FontWeight="Bold"
                    FontSize="8"
                    Click="subProductButton_Click"/>

                <TextBlock Name="countProducts"
                    Text="10" 
                       FontSize="10"
                           FontWeight="Medium"
                       TextAlignment="Center"
                       Height="20"
                       Width="25"
                       Padding="0,3,0,0"
                       Margin="0,0,0,0"/>

                <Button x:Name="addProductButton"
                    Width ="20"
                    Height="20"
                    Background="Transparent"                  
                    BorderBrush="Transparent"
                    Content ="➕"
                    Foreground="Brown"
                    FontWeight="Bold"
                    FontSize="8"
                    Click="addProductButton_Click"/>
            </StackPanel>
        </Border>

        <Border Name="Setting02"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                Grid.Row="1"
                Height="40"
                VerticalAlignment="Top"
                Background="White"
                Margin="20,0,20,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel 
                     Orientation="Horizontal">
                <Label Content="Số lượng đơn hàng mỗi trang: "
                   FontSize="12"
                   FontWeight ="Medium"
                   VerticalContentAlignment="Center"     
                   Height="30"
                   Width="190"/>
                <Button Name="subOrderButton"
                    Width ="20"
                    Height="20"
                    Background="Transparent"                  
                    BorderBrush="Transparent"
                    Foreground="Brown"
                    Content ="➖"
                    FontWeight="Bold"
                    FontSize="8" Click="subOrderButton_Click"/>

                <TextBlock Name="countOrders"
                           Text="10" 
                           FontSize="10"
                           FontWeight="Medium"
                           TextAlignment="Center"
                           Height="20"
                           Width="25"
                           Padding="0,3,0,0"
                           Margin="0,0,0,0"/>

                <Button x:Name="addOrderButton"
                    Width ="20"
                    Height="20"
                    Background="Transparent"                  
                    BorderBrush="Transparent"
                    Content ="➕"
                    Foreground="Brown"
                    FontWeight="Bold"
                    FontSize="8" Click="addOrderButton_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <Button x:Name="SaveSetting"
                Content ="Lưu"
                FontSize="11"
                Width="75"
                Height="30"
                Background="AliceBlue"
                FontWeight="Bold"
                Margin="0,0,10,0"
                Style="{ StaticResource RoundedButtonStyle}" Click="SaveSetting_Click"/>

            <Button x:Name="CloseSetting"
                Content ="Đóng"
                    FontSize="11"
                Width="75"
                Height="30"
                Background="AliceBlue"
                FontWeight="Bold"
                    Margin="10,0,0,0"
                Style="{ StaticResource RoundedButtonStyle}" Click="CloseSetting_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
