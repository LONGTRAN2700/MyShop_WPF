<UserControl x:Class="BookStoreManagement.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             Height="458" Width="690">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Background="AliceBlue" Grid.Column="0" Grid.Row="0">
            <Label Content="Số lượng sản phẩm đang bán"/>
            <TextBlock Text="0"/>
        </StackPanel>

        <StackPanel Background="AntiqueWhite"
                    Grid.Column="1" Grid.Row="0">
            <Label Content="Số đơn hàng mới trong tuần"/>
            <TextBlock Text="0"/>
        </StackPanel>

        <StackPanel Background="Aqua"
                    Grid.Column="2" Grid.Row="0">
            <Label Content="Sắp hết hàng"/>
            <TextBlock Text="0"/>
        </StackPanel>
    </Grid>
</UserControl>
