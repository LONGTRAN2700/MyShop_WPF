<UserControl x:Class="BookStoreManagement.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             Height="530" Width="790" Loaded="DashBoard_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/UIResource.xaml"/>
                <ResourceDictionary Source="Resource/ColorResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <!--Số lượng sản phẩm đang bán-->
        <Border Name="Products"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="0" Grid.Row="0"
                Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="10,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel >
                <Label Content="PRODUCTS"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                      
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblProduct"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(sản phẩm đang bán)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

            </StackPanel>
        </Border>


        <Border Name="Produ"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="1" Grid.Row="0"
                Height="100" 
                Width="160"
               Background="White"
               VerticalAlignment="Top"
                Margin="5,20,0,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel Name="OrderStackPanel">
                <Label Content="ORDERS"
                        FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>

                <TextBlock Name="tblOrderQuantity"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(đơn hàng trong tuần)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!--Sắp hết hàng-->
        <Border Name="Product"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="2" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="0,20,10,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="RUNNING OUT OF STOCK"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblStock"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="Medium"
                           FontSize="22"/>
                <Label Content="(số lượng ‹ 5)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Name="Producs"
                CornerRadius="5"  
                BorderBrush="{StaticResource ColorBackground1}" 
                BorderThickness="2"
                HorizontalAlignment="Center"
                Grid.Column="3" Grid.Row="0"
                 Height="100" 
                Width="160"
                Background="White"
                VerticalAlignment="Top"
                Margin="0,20,25,0"
                >
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="10"
                    Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <Label Content="CUSTOMER"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
                <TextBlock Name="tblCustomer"
                           Text="0"
                           Margin="15,0,0,0"
                           Foreground="Blue"
                           FontWeight="medium"
                           FontSize="22"/>
                <Label Content="(khách hàng)"
                       FontSize="8"
                       Foreground="Gray"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
