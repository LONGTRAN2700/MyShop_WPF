<Window x:Class="BookStoreManagement.registerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagement"
        mc:Ignorable="d"
        Title="registerWindow" Height="525" Width="700">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/UIResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
    
    <Grid>
        <Grid.Background>
            <!-- Placeholder for background gradient -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Cornsilk"  Offset="0.0"/>
                <GradientStop Color="Aqua"  Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition Width="450"></ColumnDefinition>
        </Grid.ColumnDefinitions>
 
        <TextBlock Text="ĐĂNG KÝ" 
                   HorizontalAlignment="Center" 
                   Margin="0, 10, 0, 0 "
                   FontWeight="Bold" FontSize="24"
                   Grid.ColumnSpan="2"/>
        <Image Name="logoLogin"
                   Source="Images/Login/logo.png"
                   Width="200" 
                   Height="200" 
                   Margin="0,0, 0, 45"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Margin="0, 50, 10, 0"
                     Grid.Column="1"
                    HorizontalAlignment="Right" 
                    Width="426" Height="300"
                   >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="71" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <!-- Tên đăng nhập -->
                <StackPanel Grid.Row="0" Grid.Column="0" >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Tên đăng nhập:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorUsername"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    
                    <TextBox  Name="txtUsername"
                              Width="200" Height="30"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource FlatTextBox}" 
                              Background="Transparent"/>
                </StackPanel>


                <!-- Mật khẩu -->
                <StackPanel Margin="10, 0, 0, 0" Grid.Row="0" Grid.Column="1"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Mật khẩu:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorPassword"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <PasswordBox Name="txtPassword"
                                 Width="204" Height="30"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Margin="4 0 0 0"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource FlatPasswordBox}"/>
                </StackPanel>


                <!-- Họ tên -->
                <StackPanel Grid.Row="1" Grid.Column="0"
                            
                            Margin="0, 15, 0, 0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Họ tên:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorFullname"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtFullname"
                             Width="200" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                             Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                </StackPanel>

                <!-- Giới tính -->
                <StackPanel Margin="10, 15, 0, 0" 
                            Grid.Row="1" Grid.Column="1"
                             >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Giới tính:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorSex"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <ComboBox Name="txtSex"
                              Height="30"
                              Width="100" 
                              FontSize="12"
                              FontWeight="Medium"
                              HorizontalAlignment="Left"
                              Style="{StaticResource ComboBoxFlatStyle}">
                        <ComboBoxItem>Nam</ComboBoxItem>
                        <ComboBoxItem>Nữ</ComboBoxItem>
                       
                    </ComboBox>
                              
                </StackPanel>

                <!-- Số điện thoại -->
                <StackPanel Grid.Row="2" Grid.Column="0"

                            Margin="0, 15, 0, 0">
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Số điện thoại:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorPhone"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox Name="txtPhone"
                             Width="200" Height="30"
                             FontSize="12"
                             FontWeight="Medium"
                              Margin="4 0 0 0"
                             HorizontalAlignment="Left"
                             Style="{StaticResource FlatTextBox}" 
                             Background="Transparent"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="10, 15 , 0, 0" Grid.Row="2" Grid.Column="1"
                            >
                    <StackPanel Orientation="Horizontal">
                        <Label  Content="Email:" 
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Brown"
                            HorizontalAlignment="Left"/>
                        <TextBlock Name="txtErrorEmail"
                                   Text="*Chưa điền thông tin"
                                   FontSize="9"
                                   Width="0"
                                   VerticalAlignment="Center"
                                   Foreground="Red"
                                   Margin="0, 0, 0, 0"/>
                    </StackPanel>
                    <TextBox  Name="txtEmail"
                              Width="204" Height="30"
                              FontSize="12"
                              FontWeight="Medium"
                              Margin="4 0 0 0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource FlatTextBox}" 
                              Background="Transparent"/>
                </StackPanel>
            </Grid>
            <Button Name="registButton" Content="Đăng ký"
                    Height="35"
                   
                    FontWeight="Bold"
                    Style="{StaticResource FlatButton}"
                    Margin="0, 20, 0 ,0" Click="registButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
