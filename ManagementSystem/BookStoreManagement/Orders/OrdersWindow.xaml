<UserControl x:Class="BookStoreManagement.Orders.OrdersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookStoreManagement"
             mc:Ignorable="d" 
             d:DesignHeight="530" d:DesignWidth="790" Loaded="Order_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:RelativeToAbsoluteConverter x:Key="AbsoluteConverter"/>
            <local:ToMoneyConverter x:Key="MoneyConverter"/>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Resource/UIResource.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="450"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Height="50"
                    Orientation="Horizontal">
            <!--Cột Mã đơn hàng-->
            <TextBlock Text="Mã đơn hàng"
                   Height="30"
                   FontSize="11"
                   TextAlignment="Center"
                   FontWeight="Medium"
                   Padding="0,10,0,0"
                   Width="75"
                   Margin="65,0,0,0"
                   Background="Transparent"/>

            <!--Cột khách hàng-->
            <TextBlock Text="Khách hàng"
                       TextAlignment="Center"
                       FontSize="11"
                       FontWeight="Medium"
                       Height="30"
                       Width="80"
                       Padding="0,10,0,0"
                       Margin="40,0,5,0"
                       Background="Transparent"/>

            <!--Cột thời gian-->
            <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="60,0,5,0"
                        >
                <TextBlock Text="Ngày đặt"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="60"
                           Background="Transparent"/>
                <ComboBox Name="OrderDateCombobox"
                          Margin="0,0,0,0" Width="45" 
                          FontSize="12"
                          FontWeight="Bold"
                          SelectionChanged="OrderDate_SelectionChanged"
                          Style="{StaticResource ComboBoxFlatStyle}">
                    <ComboBoxItem Content="⚙ Mặc định" 
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    <ComboBoxItem Content="⏫ Mới nhất" 
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    <ComboBoxItem Content="⏬ Cũ nhất"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                </ComboBox>
            </StackPanel>

            <!--Cột trạng thái-->
            <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="25,0,5,0"
                        >
                <TextBlock Text="Trạng thái"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="70"
                           Background="Transparent"/>
                <ComboBox Name="StatusCombobox"
                          Margin="0,0,0,0" Width="45" 
                          FontSize="12"
                          FontWeight="Bold"
                           SelectionChanged="StatusCombobox_SelectionChanged"
                          Style="{StaticResource ComboBoxFlatStyle}">
                    <ComboBoxItem Content="⚙ Mặc định" 
                                 FontSize="12"
                                 FontWeight="Bold"/>
                    <ComboBoxItem Content="🚚 Đang giao hàng" 
                                 FontSize="12"
                                 FontWeight="Bold"/>
                    <ComboBoxItem Content="🔄 Đang xử lí"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    <ComboBoxItem Content="✅ Đã giao thành công"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    <ComboBoxItem Content="❌ Hủy đơn"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                </ComboBox>
            </StackPanel>

            <!--Cột tổng tiền-->
            <StackPanel Orientation="Horizontal"
                        Width="120"
                        Height="30"
                        Margin="10,0,5,0"
                        >
                <TextBlock Text="Tổng tiền"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Medium"
                           Padding="0,10,0,0"
                           Height="30"
                           Width="90"
                           Background="Transparent"/>

            </StackPanel>
        </StackPanel>
        
        <ListView Name="OrderList" 
                  Margin="10,50,10,40"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Brown"
                  BorderThickness="1,2,1,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle >
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="3, 1, 3, 1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Name="detailOrderButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0, 7, 0, 7"
                            Height ="45"
                            Width="650"
                            Background="LightGreen"
                            BorderBrush="Transparent"                           
                            Click="detailOrderButton_Click"
                            Style="{StaticResource RoundedButtonStyle}">
                        <StackPanel Margin="0, 0, 0, 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="650">
                            <!--Mã hóa đơn--> 
                            <TextBlock x:Name="txtOrderID" 
                                       Width="65"
                                       TextAlignment="Center"
                                       Text="{Binding OrderId}" 
                                       FontSize="11"  
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>
                            
                            <!--Tên khách hàng-->
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="11"
                                       Width="180"
                                       Margin="0, 0, 0, 0"
                                       TextAlignment="Center"
                                       FontWeight="Medium"/>
                            
                            <!--Thời gian-->
                            <TextBlock Text="{Binding OrderDate}"
                                       FontSize="11"
                                       Width="130"
                                       TextAlignment="Center"
                                       Margin="0, 0, 0, 0"
                                       FontWeight="Medium"/>

                            <!--Trạng thái-->
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Width="100"
                                       TextAlignment="Center"
                                       Margin="35, 0, 10, 0"
                                       FontWeight="Medium"/>

                            <!--Tổng tiền-->
                            <TextBlock Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}"
                                       FontSize="11"
                                       Width="140"
                                       TextAlignment="Center"
                                       Margin="0, 0, 10, 0"
                                       FontWeight="Medium"
                                       />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="0">
            <Button x:Name="AddOrder"
                    Content="➕Tạo" 
                    Width="55"
                    Height="27"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Background="LightGreen"
                    FontSize="11"
                    FontWeight="Medium"
                    Margin="20, 0, 5, 0"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Click="AddOrder_Click"/>
        </Grid>
    </Grid>
</UserControl>
